{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mitosia-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "mitosia-prod-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env; set +a; PORT=3001 exec node scripts/serve-standalone.mjs"
      ],
      "port": 3001
    }
  ]
}
