# Local Postgres from docker-compose.yml.
# The app role is a non-superuser so Row Level Security applies to it —
# never point DATABASE_URL at the superuser (it bypasses RLS).
DATABASE_URL=postgres://mitosia_app:mitosia_app@localhost:55433/mitosia
# Owner connection used only for migrations (drizzle-kit + entrypoint).
MIGRATE_DATABASE_URL=postgres://mitosia:mitosia@localhost:55433/mitosia

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# App origin for auth callbacks
BETTER_AUTH_URL=http://localhost:3000

# S3-compatible object storage for source media and pipeline artifacts.
# Local dev: MinIO from docker-compose.yml (console at http://localhost:55491).
# Staging/prod: Cloudflare R2 — endpoint https://<account>.r2.cloudflarestorage.com,
# path style false, and a bucket CORS rule exposing ETag for browser uploads.
STORAGE_ENDPOINT=http://localhost:55490
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=mitosia
STORAGE_SECRET_ACCESS_KEY=mitosia-dev
STORAGE_BUCKET=mitosia-media
STORAGE_FORCE_PATH_STYLE=true

# Trigger.dev (durable ingest workflow runtime). Leave unset in local dev:
# without it the app falls back to running ingest in-process (dev only).
# Setup guide: docs/media-infra-setup.md
# TRIGGER_SECRET_KEY=
# TRIGGER_PROJECT_REF=

# Transcription (S3). Unset = transcription disabled: sources simply get no
# transcript. DEEPGRAM_API_KEY alone enables Deepgram (nova-3, diarization).
# TRANSCRIPTION_PROVIDER overrides selection: "deepgram", or "mock" — a
# deterministic fake for e2e/dev with no API key (playwright.config.ts sets
# it for the server it starts). Also set DEEPGRAM_API_KEY in the Trigger.dev
# environment: the transcribe-source task runs there, not in the app.
# DEEPGRAM_API_KEY=
# AssemblyAI is the automatic fallback when its key is set (and the
# provider with a max-speakers diarization hint).
# ASSEMBLYAI_API_KEY=
# TRANSCRIPTION_PROVIDER=

# AI harness (S4). Anthropic direct is the primary model path; OpenRouter
# is a break-glass fallback used only when the primary call fails. Unset =
# AI capabilities disabled (sources get no analysis). Also set in the
# Trigger.dev environment — analysis runs there.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Cold-context reviewer agent over discovered moments (S6 §9). "on"
# enables one small verdict call per surviving candidate (sonnet; adds
# roughly $0.10-0.20 per source). Any other value = off; mock analysis
# mode always reviews so the CI chain proves the path. Set in the
# Trigger.dev environment too — discovery runs there.
# MOMENT_REVIEWER=

# Langfuse tracing + prompt registry (Cloud; keys from the project
# settings). Optional everywhere — absence disables tracing, never boot.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Embeddings (S5 semantic search + source Q&A). Unset = sources get no
# search index. VOYAGE_API_KEY alone enables Voyage (voyage-4, 1024 dims —
# the dimension is baked into the transcript_chunk migration).
# EMBEDDING_PROVIDER overrides selection: "voyage", or "mock" — a
# deterministic fake for e2e/dev (playwright.config.ts sets it for the
# server it starts). Also set VOYAGE_API_KEY in the Trigger.dev
# environment: the index-source task runs there, not in the app.
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=
