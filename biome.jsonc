{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": ["!public"]
  },
  "overrides": [
    {
      // Vendored shadcn registry output — regenerated by the CLI, not hand-maintained
      "includes": ["components/ui/**", "hooks/use-mobile.ts"],
      "linter": { "enabled": false }
    },
    {
      // Drizzle requires the full schema object (namespace import + schema index);
      // server-only modules where tree-shaking is irrelevant
      "includes": ["lib/db/**", "lib/auth.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
