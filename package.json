{
  "name": "mitosia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ai:costs": "esbuild scripts/ai-costs.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --alias:@=. --outfile=scripts/.ai-costs.cjs && node --env-file-if-exists=.env scripts/.ai-costs.cjs",
    "backfill:artifact-sizes": "esbuild scripts/backfill-artifact-sizes.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --outfile=scripts/.backfill-artifact-sizes.cjs && node --env-file-if-exists=.env scripts/.backfill-artifact-sizes.cjs",
    "build": "next build",
    "check": "ultracite check",
    "check:abort-rule": "esbuild scripts/check-multipart-abort-rule.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --outfile=scripts/.check-multipart-abort-rule.cjs && node --env-file-if-exists=.env scripts/.check-multipart-abort-rule.cjs",
    "check:ffmpeg": "node scripts/check-ffmpeg-version.mjs",
    "check:traefik": "node scripts/check-traefik-config.mjs",
    "ci:attest": "node scripts/verified-pr.mjs attest",
    "ci:local": "node scripts/local-ci.mjs",
    "db:auth:generate": "pnpm dlx @better-auth/cli@latest generate --config lib/auth.ts --output lib/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:latency": "node --env-file-if-exists=.env scripts/db-latency.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:provision-app-role": "node --env-file-if-exists=.env scripts/provision-app-role.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "eval": "esbuild scripts/run-evals.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --alias:@=. --outfile=scripts/.run-evals.cjs && node --env-file-if-exists=.env scripts/.run-evals.cjs",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "moments:metrics": "esbuild scripts/moment-metrics.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --alias:@=. --outfile=scripts/.moment-metrics.cjs && node --env-file-if-exists=.env scripts/.moment-metrics.cjs",
    "pr:verified": "node scripts/verified-pr.mjs pr",
    "prepare": "node scripts/install-git-hooks.mjs",
    "push:verified": "node scripts/verified-pr.mjs push",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@base-ui/react": "^1.7.0",
    "@deepgram/sdk": "^5.8.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@langfuse/vercel-ai-sdk": "^5.10.1",
    "@mastra/core": "1.61.0",
    "@mastra/langfuse": "^1.5.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@react-email/render": "^2.1.0",
    "@remotion/captions": "^4.0.515",
    "@tanstack/react-virtual": "^3.14.10",
    "@trigger.dev/sdk": "^4.5.12",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/golden-retriever": "^5.2.1",
    "@uppy/react": "^5.2.0",
    "@videojs/react": "10.0.0-beta.26",
    "ai": "^7.0.77",
    "assemblyai": "^4.36.7",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "peaks.js": "^4.0.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@trigger.dev/build": "^4.5.12",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "7.10.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "deepmerge-ts@<8.0.0": "8.0.0",
      "esbuild@<0.25.0": ">=0.25.0",
      "ws@>=8.0.0 <8.21.0": "~8.21.3"
    }
  }
}
