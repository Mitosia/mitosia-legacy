{
  "name": "mitosia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "ultracite check",
    "db:auth:generate": "pnpm dlx @better-auth/cli@latest generate --config lib/auth.ts --output lib/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
